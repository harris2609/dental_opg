{
    "name": "OPG Standard Finding",
    "module": "Dental OPG Reporting",
    "doctype": "DocType",
    "engine": "InnoDB",
    "autoname": "hash",
    "naming_rule": "Random",
    "is_submittable": 0,
    "sort_field": "modified",
    "sort_order": "DESC",
    "fields": [
        {
            "fieldname": "section_name",
            "fieldtype": "Select",
            "label": "Section",
            "options": "Condylar Morphology\nStyloid Process\nMaxillary Sinus\nInferior Border of Mandible\nMaxillary Arch\nMandibular Arch\nRadiologic Impression",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "finding_label",
            "fieldtype": "Data",
            "label": "Finding Label",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "finding_template",
            "fieldtype": "Small Text",
            "label": "Finding Template",
            "description": "Use {side}, {tooth_number}, {level} as placeholders for report text assembly",
            "reqd": 1
        },
        {
            "fieldname": "column_break_1",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "allow_side",
            "fieldtype": "Check",
            "label": "Allow Side (Left/Right/Bilateral)"
        },
        {
            "fieldname": "allow_tooth",
            "fieldtype": "Check",
            "label": "Allow Tooth Number"
        },
        {
            "fieldname": "allow_level",
            "fieldtype": "Check",
            "label": "Allow Level (Cervical/Middle/Apical Third)"
        },
        {
            "fieldname": "active",
            "fieldtype": "Check",
            "label": "Active",
            "default": "1",
            "in_list_view": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        }
    ]
}
