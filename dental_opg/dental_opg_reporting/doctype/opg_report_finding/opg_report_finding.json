{
    "name": "OPG Report Finding",
    "module": "Dental OPG Reporting",
    "doctype": "DocType",
    "engine": "InnoDB",
    "istable": 1,
    "autoname": "hash",
    "naming_rule": "Random",
    "fields": [
        {
            "fieldname": "section",
            "fieldtype": "Select",
            "label": "Section",
            "options": "Condylar Morphology\nStyloid Process\nMaxillary Sinus\nInferior Border of Mandible\nMaxillary Arch\nMandibular Arch\nRadiologic Impression",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "finding",
            "fieldtype": "Link",
            "label": "Standard Finding",
            "options": "OPG Standard Finding",
            "in_list_view": 1
        },
        {
            "fieldname": "is_custom",
            "fieldtype": "Check",
            "label": "Custom Entry"
        },
        {
            "fieldname": "custom_text",
            "fieldtype": "Small Text",
            "label": "Custom Text",
            "in_list_view": 1
        },
        {
            "fieldname": "side",
            "fieldtype": "Select",
            "label": "Side",
            "options": "\nLeft\nRight\nBilateral"
        },
        {
            "fieldname": "tooth_number",
            "fieldtype": "Data",
            "label": "Tooth Number"
        },
        {
            "fieldname": "level",
            "fieldtype": "Select",
            "label": "Level",
            "options": "\nCervical Third\nMiddle Third\nApical Third"
        }
    ]
}
