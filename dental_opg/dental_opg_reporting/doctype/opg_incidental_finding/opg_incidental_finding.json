{
    "name": "OPG Incidental Finding",
    "module": "Dental OPG Reporting",
    "doctype": "DocType",
    "engine": "InnoDB",
    "autoname": "hash",
    "naming_rule": "Random",
    "is_submittable": 0,
    "sort_field": "modified",
    "sort_order": "DESC",
    "fields": [
        {
            "fieldname": "report",
            "fieldtype": "Link",
            "label": "Report",
            "options": "OPG Report",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "patient",
            "fieldtype": "Link",
            "label": "Patient",
            "options": "OPG Patient",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "reported_by",
            "fieldtype": "Data",
            "label": "Reported By",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "finding_type",
            "fieldtype": "Data",
            "label": "Finding Type",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "side",
            "fieldtype": "Select",
            "label": "Side",
            "options": "Left\nRight\nBilateral",
            "reqd": 1
        },
        {
            "fieldname": "severity",
            "fieldtype": "Select",
            "label": "Severity",
            "options": "Mild\nModerate\nSevere",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "finding_date",
            "fieldtype": "Date",
            "label": "Finding Date",
            "default": "Today",
            "in_list_view": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        }
    ]
}
