[
    {
        "doctype": "Print Format",
        "name": "OPG Report",
        "doc_type": "OPG Report",
        "module": "Dental OPG Reporting",
        "print_format_type": "Jinja",
        "standard": "Yes",
        "disabled": 0,
        "html": "<style>\n  .opg-print { font-family: 'Times New Roman', Times, serif; font-size: 12pt; color:#000; }\n  .opg-print table.opg-details { width:100%; border-collapse:collapse; margin-bottom:10pt; }\n  .opg-print table.opg-details td { border:1px solid #9CC2E5; padding:4px 8px; font-size:12pt; }\n  .opg-print table.opg-details tr.opg-row-first td { border-bottom:2px solid #9CC2E5; font-weight:bold; }\n  .opg-print table.opg-details tr.opg-row-band td { background:#DEEAF6; }\n  .opg-print .opg-section-name { font-weight:bold; text-decoration:underline; font-size:11pt; margin-top:8pt; }\n  .opg-print .opg-section-line { font-size:12pt; margin:1pt 0; }\n  .opg-print ul.opg-section-list { margin:2pt 0 2pt 0; padding-left:22px; }\n  .opg-print ul.opg-section-list li { font-size:12pt; margin:1pt 0; }\n</style>\n\n<div id=\"header-html\">\n  <div style=\"font-family: 'Times New Roman', Times, serif;\">\n    <div style=\"text-align:center;\">\n      <img src=\"/assets/dental_opg/images/yenepoya_logo.jpg\" style=\"height:55px;\" />\n    </div>\n    <div style=\"text-align:center; font-weight:bold; text-decoration:underline; font-size:20pt; color:#002060; margin-top:4pt;\">DEPARTMENT OF ORAL MEDICINE &amp; RADIOLOGY</div>\n    <div style=\"text-align:center; font-weight:bold; text-decoration:underline; font-size:14pt; color:#002060; margin-bottom:6pt;\">University Road, Deralakatte, Mangalore - 575018</div>\n    <div style=\"height:14px; background:repeating-linear-gradient(120deg, #0070C0 0px, #0070C0 22px, #ffffff 22px, #ffffff 30px);\"></div>\n  </div>\n</div>\n\n<div class=\"opg-print\">\n  <table class=\"opg-details\">\n    <tr class=\"opg-row-first\">\n      <td style=\"width:55%;\">PATIENT NAME&nbsp;&nbsp;: {{ frappe.db.get_value(\"OPG Patient\", doc.patient, \"patient_name\") or \"\" }}</td>\n      <td>AGE / SEX&nbsp;&nbsp;: {{ frappe.db.get_value(\"OPG Patient\", doc.patient, \"age\") or \"\" }} / {{ (frappe.db.get_value(\"OPG Patient\", doc.patient, \"sex\") or \"\")[:1] }}</td>\n    </tr>\n    <tr class=\"opg-row-band\">\n      <td>REGISTRATION NO&nbsp;&nbsp;: {{ frappe.db.get_value(\"OPG Patient\", doc.patient, \"registration_no\") or \"\" }}</td>\n      <td>DATE&nbsp;&nbsp;: {{ frappe.utils.formatdate(doc.report_date) if doc.report_date else \"\" }}</td>\n    </tr>\n    <tr>\n      <td>REFERRED BY&nbsp;&nbsp;: {{ doc.referred_by or \"\" }}</td>\n      <td>RADIOGRAPHIC PROJECTION&nbsp;&nbsp;: {{ doc.radiographic_projection or \"OPG\" }}</td>\n    </tr>\n    <tr class=\"opg-row-band\">\n      <td colspan=\"2\">CLINICAL DIAGNOSIS&nbsp;&nbsp;: {{ doc.clinical_diagnosis or \"\" }}</td>\n    </tr>\n  </table>\n\n  <div style=\"text-align:center; font-weight:bold; text-decoration:underline; margin:10pt 0;\">REPORT</div>\n\n  {% if doc.opg_image %}\n  <div style=\"text-align:center; margin-bottom:12pt;\">\n    <img src=\"/api/method/dental_opg.dental_opg_reporting.doctype.opg_report.opg_report.get_annotated_report_image?name={{ doc.name }}\" style=\"max-width:100%; max-height:280px;\" />\n  </div>\n  {% endif %}\n\n  <div style=\"font-weight:bold; text-decoration:underline; margin-bottom:8pt;\">PANORAMIC RADIOGRAPH SHOWS:</div>\n\n  {% for section in build_report_sections(doc) %}\n  <div class=\"opg-section-name\">{{ section.name }}:</div>\n  {% if section.name in (\"MAXILLARY ARCH\", \"MANDIBULAR ARCH\") %}\n  <ul class=\"opg-section-list\">\n    {% for line in section.lines %}\n    <li>{{ line.replace(\"\\n\", \"<br>\") }}</li>\n    {% endfor %}\n  </ul>\n  {% else %}\n  {% for line in section.lines %}\n  <div class=\"opg-section-line\">{{ line.replace(\"\\n\", \"<br>\") }}</div>\n  {% endfor %}\n  {% endif %}\n  {% endfor %}\n</div>\n\n<div id=\"footer-html\">\n  <table style=\"width:100%; border-collapse:collapse; font-family:'Times New Roman', Times, serif; font-size:14pt; font-weight:bold;\">\n    <tr>\n      <td style=\"width:50%; color:#000; text-align:center; vertical-align:middle; padding:6px;\">Reported by: {{ doc.reported_by or \"\" }}</td>\n      <td style=\"width:50%; color:#000; text-align:center; vertical-align:middle; padding:6px;\">Verified by: {{ doc.verified_by or \"\" }}</td>\n    </tr>\n  </table>\n  <div style=\"text-align:center; font-family:'Times New Roman', Times, serif; font-size:11pt; font-weight:normal; color:#000; padding:4px 0;\">Email: ydcxray@yenepoya.edu.in</div>\n</div>\n",
        "modified": "2026-10-13 12:00:00.000000"
    }
]
